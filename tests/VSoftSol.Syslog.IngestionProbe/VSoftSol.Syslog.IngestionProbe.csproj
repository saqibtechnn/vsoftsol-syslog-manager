<Project Sdk="Microsoft.NET.Sdk">

  <!-- Out-of-process ingestion host for the Phase 2 hard-kill / chaos tests. Not a test
       project (no test SDK); the IntegrationTests project takes a build-only reference and
       launches it with Process.Start / Process.Kill. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <NoWarn>$(NoWarn);CA1031;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VSoftSol.Syslog.Core\VSoftSol.Syslog.Core.csproj" />
    <ProjectReference Include="..\..\src\VSoftSol.Syslog.Data\VSoftSol.Syslog.Data.csproj" />
    <ProjectReference Include="..\..\src\VSoftSol.Syslog.Ingestion\VSoftSol.Syslog.Ingestion.csproj" />
  </ItemGroup>

</Project>
