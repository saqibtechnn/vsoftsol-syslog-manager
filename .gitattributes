# Normalize line endings: text files are LF in the repo, checked out native.
* text=auto eol=lf

# Windows-native scripts stay CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch
*.png binary
*.ico binary
*.bmp binary
*.jpg binary
*.zip binary
*.snk binary
