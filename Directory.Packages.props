<Project>

  <!--
    Central Package Management. SECURITY_STANDARDS.md §5.9: dependencies are pinned
    and reviewed, no floating version ranges. Every version lives here, once.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosting / Windows Service -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="8.0.0" />
    <!-- v1.1 — self-update's GitHubUpdateClient (services.AddHttpClient<T>()). -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />

    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.EventLog" Version="4.0.0" />

    <!-- Data layer -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.30" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />

    <!-- Branding asset derivation. ImageSharp 2.1.x is Apache-2.0 (the 3.x split
         license does not apply); 2.1.13 clears the advisories that affected 2.1.9. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="2.1.13" />

    <!-- Authentication (Phase 4). Argon2id is not in the BCL; Konscious is a pure-managed
         MIT implementation with no transitive dependencies. DPAPI (ProtectedData) backs the
         secret store on Windows. Both are on the ingest-free UI/data path only. -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />

    <!-- Rule actions (Phase 7). ODBC is a Microsoft-owned BCL-adjacent package (MIT); the
         WriteToOdbc action needs it. Every other action type uses only in-box BCL
         (System.Net.Mail, HttpClient, System.Diagnostics.Process, sockets). -->
    <PackageVersion Include="System.Data.Odbc" Version="8.0.1" />

    <!-- Retention archives (Phase 10). ZstdSharp.Port is a pure-managed C# port of zstd
         (MIT, no native binary/P/Invoke — no platform risk); CompressorFactory still falls
         back to the in-box GZipStream if it were ever unavailable. QuestPDF renders report
         PDFs (Community licence — free under the small-business revenue threshold; set via
         QuestPDF.Settings.License at startup, PHASE_10 build item 7). -->
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.1" />
    <PackageVersion Include="QuestPDF" Version="2024.10.3" />

    <!-- Test stack -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions" Version="6.12.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="FsCheck" Version="2.16.6" />
    <PackageVersion Include="FsCheck.Xunit" Version="2.16.6" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="coverlet.msbuild" Version="6.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />

    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />

    <!-- Static analysis (SECURITY_STANDARDS.md §4 SAST) -->
    <PackageVersion Include="Roslynator.Analyzers" Version="4.12.9" />
    <PackageVersion Include="SecurityCodeScan.VS2019" Version="5.6.7" />

    <!-- Installer (Phase 12) -->
    <PackageVersion Include="WixToolset.Util.wixext" Version="7.0.0" />
    <PackageVersion Include="WixToolset.Firewall.wixext" Version="7.0.0" />
    <PackageVersion Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>

  <!-- Transitive pins (CentralPackageTransitivePinningEnabled). Legacy System.* packages
       dragged in by older test-only analyzers (NetArchTest, FsCheck) carry High CVEs at
       their pinned-by-dependency versions; force the patched releases.
       SECURITY_STANDARDS.md §4: SCA must be clean, test projects included. -->
  <ItemGroup>
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
    <PackageVersion Include="System.Security.Cryptography.X509Certificates" Version="4.3.2" />
    <PackageVersion Include="System.Text.RegularExpressions" Version="4.3.1" />
    <!-- Keep System.Text.Json ahead of the 8.0.4 transitive that carries GHSA-8g4q-xg66-9fp4. -->
    <PackageVersion Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
