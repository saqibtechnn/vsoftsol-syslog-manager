<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Windows Service host. Composition root: every DI registration the product needs
       is declared here and reused by the Web project. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>VSoftSol.Syslog.Service</RootNamespace>
    <AssemblyName>VSoftSol.Syslog.Service</AssemblyName>
    <UserSecretsId>vsoftsol-syslog-service</UserSecretsId>
    <!-- The collector is an allocation-heavy, concurrent producer/consumer workload
         (listeners + parse pipeline + writer). Server GC keeps the parse path off the
         throughput cliff on multi-core hosts. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Hosting is supplied implicitly by Microsoft.NET.Sdk.Worker. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!-- v1.1 — self-update's GitHubUpdateClient. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.EventLog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VSoftSol.Syslog.Core\VSoftSol.Syslog.Core.csproj" />
    <ProjectReference Include="..\VSoftSol.Syslog.Data\VSoftSol.Syslog.Data.csproj" />
    <ProjectReference Include="..\VSoftSol.Syslog.Ingestion\VSoftSol.Syslog.Ingestion.csproj" />
    <ProjectReference Include="..\VSoftSol.Syslog.Rules\VSoftSol.Syslog.Rules.csproj" />
    <ProjectReference Include="..\VSoftSol.Syslog.Reporting\VSoftSol.Syslog.Reporting.csproj" />
  </ItemGroup>

  <!-- PHASE_12: Web references this project only for the composition root
       (SyslogPlatformExtensions) and would otherwise inherit this appsettings.json into
       its own publish output, colliding with Web's own file at the same relative path
       (NETSDK1152). ExcludeAppSettingsFromPublish is set only via the Properties metadata
       on Web's ProjectReference to this project — Service's own build/publish never sets
       it, so `dotnet publish src/VSoftSol.Syslog.Service` is completely unaffected. -->
  <ItemGroup Condition="'$(ExcludeAppSettingsFromPublish)' == 'true'">
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
