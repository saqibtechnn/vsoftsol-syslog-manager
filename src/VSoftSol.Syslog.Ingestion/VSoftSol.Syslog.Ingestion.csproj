<Project Sdk="Microsoft.NET.Sdk">

  <!-- Listeners, bounded channel, disk spill queue, ingest pipeline (Phase 2);
       RFC 3164/5424 parsers, extractor pipeline, runtime-loaded vendor packs (Phase 3).
       References Core only — the layering fitness test forbids Data, Rules, or Reporting. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VSoftSol.Syslog.Ingestion</RootNamespace>
    <AssemblyName>VSoftSol.Syslog.Ingestion</AssemblyName>
    <!-- DiskSpillQueue is the name PHASE_02 prescribes for this component; the -Queue
         suffix is the domain term, not a collection type. -->
    <NoWarn>$(NoWarn);CA1711</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VSoftSol.Syslog.Core\VSoftSol.Syslog.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendor parser packs are plain text, loaded at runtime — adding a vendor is a file
         drop, never a rebuild (PHASE_03 item 7). Copied next to the host executable and
         flowed to every referencing project's output. -->
    <None Include="Patterns\**\*.pack" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
