@inject NonceAccessor Nonce
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="branding/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="branding/brand.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="ds.css" />
    <link rel="stylesheet" href="VSoftSol.Syslog.Web.styles.css" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <div id="blazor-error-ui" class="ds-error-ui">
        An unexpected error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss" role="button" tabindex="0">Dismiss</a>
    </div>
    <script src="_framework/blazor.web.js" nonce="@Nonce.Value"></script>
    <script src="js/app.js" nonce="@Nonce.Value"></script>
</body>

</html>
