@page "/archives"
@attribute [Authorize(Policy = AuthPolicies.ViewAudit)]
@rendermode InteractiveServer
@using VSoftSol.Syslog.Core.Retention
@using VSoftSol.Syslog.Web.Retention
@inject RetentionAdminService Admin
@inject ToastService Toast

<PageTitle>Archives — @BrandingInfo.ProductName</PageTitle>

<div class="ds-page">
    <header class="ds-page__header">
        <h1>Archives</h1>
    </header>

    @if (_loading)
    {
        <SkeletonLoader Rows="6" />
    }
    else if (_archives.Count == 0)
    {
        <EmptyState Title="No archives yet" Icon="🗄️"
                    Explanation="Once events age past a stream's Warm horizon they are exported here as tamper-evidenced, SHA-256-hashed files, then removed from the live database." />
    }
    else
    {
        <DataTable TItem="ArchiveRecord" Items="_archives" Columns="_columns" RowKey="a => a.ArchiveId"
                   EmptyTitle="No archives" EmptyExplanation="" />
    }

    @if (_activeRestores.Count > 0)
    {
        <section class="ds-editorsection">
            <h2>Active restores</h2>
            <p class="ds-muted">Temporarily reinstated, searchable, and audited. They expire and are removed automatically.</p>
            <ul>
                @foreach (RestoreRecord r in _activeRestores)
                {
                    <li>Restore #@r.RestoreId — @r.EventCount event(s), requested by @r.RequestedBy, expires @r.ExpiresUtc.ToLocalTime().ToString("g")</li>
                }
            </ul>
        </section>
    }
</div>

<Modal Visible="_restoreTarget is not null" Title="Restore archive" VisibleChanged="v => { if (!v) _restoreTarget = null; }">
    <ChildContent>
        @if (_restoreTarget is { } archive)
        {
            <p><strong>@archive.StreamName</strong> — @archive.EventCount event(s), @archive.PeriodStartUtc.ToLocalTime().ToString("d") to @archive.PeriodEndUtc.ToLocalTime().ToString("d")</p>
            <FormField Label="Keep searchable for" FieldId="ds-expiry">
                <select id="ds-expiry" class="ds-input" @bind="_expiryDays">
                    <option value="1">1 day</option>
                    <option value="7">7 days</option>
                    <option value="14">14 days</option>
                    <option value="30">30 days</option>
                </select>
            </FormField>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="ds-button ds-button--ghost" @onclick="() => _restoreTarget = null">Cancel</button>
        <button type="button" class="ds-button ds-button--primary" @onclick="ConfirmRestoreAsync">Restore</button>
    </Footer>
</Modal>

@code {
    private bool _loading = true;
    private List<ArchiveRecord> _archives = [];
    private IReadOnlyList<RestoreRecord> _activeRestores = [];
    private IReadOnlyList<TableColumn<ArchiveRecord>> _columns = [];
    private ArchiveRecord? _restoreTarget;
    private int _expiryDays = 7;

    protected override async Task OnInitializedAsync()
    {
        _columns =
        [
            new() { Header = "Stream", SortValue = a => a.StreamName, Cell = a => @<text>@a.StreamName</text> },
            new() { Header = "Period", SortValue = a => a.PeriodStartUtc,
                    Cell = a => @<text>@a.PeriodStartUtc.ToLocalTime().ToString("yyyy-MM-dd") – @a.PeriodEndUtc.ToLocalTime().ToString("yyyy-MM-dd")</text> },
            new() { Header = "Events", Numeric = true, SortValue = a => a.EventCount, Cell = a => @<text>@a.EventCount</text> },
            new() { Header = "Size", Numeric = true, SortValue = a => a.ByteSize, Cell = a => @<text>@FormatBytes(a.ByteSize)</text> },
            new() { Header = "Status", SortValue = a => a.Status.ToString(), Cell = a => StatusChip(a) },
            new() { Header = "Restore", Cell = a => @<button type="button" class="ds-button ds-button--ghost" @onclick="() => _restoreTarget = a" disabled="@(a.Status == ArchiveStatus.TamperDetected)">Restore</button> },
        ];

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _archives = [.. await Admin.ListArchivesAsync(CancellationToken.None)];
        _activeRestores = await Admin.ListActiveRestoresAsync(CancellationToken.None);
        _loading = false;
    }

    private async Task ConfirmRestoreAsync()
    {
        if (_restoreTarget is not { } archive)
        {
            return;
        }

        RetentionActionResult result = await Admin.RequestRestoreAsync(archive.ArchiveId, _expiryDays, CancellationToken.None);
        Toast.Show(result.Ok ? ToastLevel.Success : ToastLevel.Error, result.Message);
        _restoreTarget = null;
        if (result.Ok)
        {
            await ReloadAsync();
        }
    }

    private static RenderFragment StatusChip(ArchiveRecord a) => __builder =>
    {
        string css = a.Status switch
        {
            ArchiveStatus.Ok => "ds-chip--ok",
            ArchiveStatus.TamperDetected => "ds-chip--danger",
            ArchiveStatus.Missing => "ds-chip--danger",
            _ => "ds-chip",
        };
        <span class="ds-chip @css">@a.Status</span>
    };

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes;
        int unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value:0.#} {units[unit]}";
    }
}
