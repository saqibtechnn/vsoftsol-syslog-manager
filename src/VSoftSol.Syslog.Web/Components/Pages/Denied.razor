@page "/denied"
@layout BareLayout
@attribute [Authorize]

<PageTitle>Access denied — @BrandingInfo.ProductName</PageTitle>

<h1 class="ds-bare__title">Access denied</h1>
<p class="ds-bare__lead">
    Your role does not have permission to view that page. If you think this is a mistake,
    ask an administrator to review your role and scope.
</p>
<div class="ds-form__actions">
    <a class="ds-button ds-button--primary" href="/dashboards">Back to dashboards</a>
</div>
