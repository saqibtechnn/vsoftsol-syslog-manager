@page "/account/change-password"
@layout BareLayout
@attribute [Authorize]
@inject AuthSessionService Auth
@inject NavigationManager Nav
@inject IHttpContextAccessor Http

<PageTitle>Change password — @BrandingInfo.ProductName</PageTitle>

<h1 class="ds-bare__title">Change your password</h1>

@if (_forced)
{
    <p class="ds-bare__lead">You must choose a new password before continuing.</p>
}

@if (_error is not null)
{
    <div class="ds-alert ds-alert--error" role="alert">@_error</div>
}

<EditForm Model="Model" FormName="change-password" OnValidSubmit="SubmitAsync" class="ds-form">
    <DataAnnotationsValidator />

    <FormField Label="Current password" FieldId="cp-current" Required="true">
        <InputText id="cp-current" type="password" class="ds-field__input" @bind-Value="Model.Current"
                   autocomplete="current-password" />
    </FormField>

    <FormField Label="New password" FieldId="cp-new" Required="true"
               Hint="At least 12 characters. Use a passphrase you have not used elsewhere.">
        <InputText id="cp-new" type="password" class="ds-field__input" @bind-Value="Model.New"
                   autocomplete="new-password" />
    </FormField>

    <FormField Label="Confirm new password" FieldId="cp-confirm" Required="true">
        <InputText id="cp-confirm" type="password" class="ds-field__input" @bind-Value="Model.Confirm"
                   autocomplete="new-password" />
    </FormField>

    <ValidationSummary class="ds-form__summary" />

    <div class="ds-form__actions">
        <button type="submit" class="ds-button ds-button--primary ds-button--block">Set new password</button>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm] private ChangeModel Model { get; set; } = new();

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _forced;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            _forced = (await AuthState).User.HasClaim(SyslogClaimTypes.MustChangePassword, "1");
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (Model.New != Model.Confirm)
        {
            _error = "The new password and its confirmation do not match.";
            return;
        }

        HttpContext http = Http.HttpContext!;
        PasswordChangeResult result = await Auth.ChangePasswordAsync(http, Model.Current, Model.New, http.RequestAborted);

        _error = result switch
        {
            PasswordChangeResult.Success => null,
            PasswordChangeResult.CurrentPasswordWrong => "Your current password is incorrect.",
            PasswordChangeResult.NewPasswordTooShort => "The new password is too short — use at least 12 characters.",
            PasswordChangeResult.NewPasswordSameAsOld => "The new password must be different from the current one.",
            _ => "You are not signed in.",
        };

        if (result == PasswordChangeResult.Success)
        {
            Nav.NavigateTo("/dashboards", forceLoad: true);
        }
    }

    public sealed class ChangeModel
    {
        [System.ComponentModel.DataAnnotations.Required] public string Current { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MinLength(12, ErrorMessage = "Use at least 12 characters.")]
        public string New { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required] public string Confirm { get; set; } = string.Empty;
    }
}
