@page "/rules/tester"
@attribute [Authorize(Policy = AuthPolicies.Operate)]
@rendermode InteractiveServer
@using System.Text
@using VSoftSol.Syslog.Core.Enums
@using VSoftSol.Syslog.Core.Events
@using VSoftSol.Syslog.Web.Rules
@inject RuleAdminService Admin

<PageTitle>Rule tester — @BrandingInfo.ProductName</PageTitle>

<div class="ds-page">
    <header class="ds-page__header">
        <h1>Rule tester</h1>
        <a class="ds-button ds-button--ghost" href="/rules">Back to rules</a>
    </header>

    <p class="ds-muted">Paste a message and dry-run the whole rule set. Nothing is sent — you see which rules
        match and which actions <em>would</em> run.</p>

    <FormField Label="Sample message" FieldId="t-msg">
        <textarea id="t-msg" class="ds-textarea ds-input--mono" rows="3" @bind="_message"></textarea>
    </FormField>
    <div class="ds-form__row">
        <FormField Label="Hostname" FieldId="t-host"><input id="t-host" class="ds-input ds-input--sm" @bind="_hostname" /></FormField>
        <FormField Label="Severity" FieldId="t-sev">
            <select id="t-sev" class="ds-input ds-input--sm" @bind="_severity">
                @foreach (Severity s in Enum.GetValues<Severity>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </FormField>
    </div>
    <button type="button" class="ds-button ds-button--primary" @onclick="RunAsync">Dry-run</button>

    @if (_results is not null)
    {
        <table class="ds-table ds-dryrun">
            <thead><tr><th>Rule</th><th>Result</th><th>Would run</th></tr></thead>
            <tbody>
                @foreach (RuleDryRun r in _results)
                {
                    <tr class="@(r.Matched ? "ds-dryrun--match" : null)">
                        <td>@r.RuleName</td>
                        <td>@r.Reason</td>
                        <td>@(r.WouldRun.Count > 0 ? string.Join(", ", r.WouldRun) : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private string _message = "authentication failure for user root";
    private string _hostname = "core-sw-1";
    private Severity _severity = Severity.Error;
    private IReadOnlyList<RuleDryRun>? _results;

    private async Task RunAsync()
    {
        var sample = new SyslogEvent
        {
            ReceivedUtc = DateTimeOffset.UtcNow,
            SourceIp = "203.0.113.5",
            Hostname = string.IsNullOrWhiteSpace(_hostname) ? null : _hostname,
            Severity = _severity,
            Facility = Facility.Local0,
            Protocol = Protocol.Udp,
            Message = _message,
            RawMessage = Encoding.UTF8.GetBytes(_message),
            ParseStatus = ParseStatus.Rfc3164,
        };
        _results = await Admin.DryRunAsync(sample, CancellationToken.None);
    }
}
