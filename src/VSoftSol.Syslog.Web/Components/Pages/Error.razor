@page "/Error"
@layout BareLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components

<PageTitle>Error — @BrandingInfo.ProductName</PageTitle>

<h1 class="ds-bare__title">Something went wrong</h1>
<p class="ds-bare__lead">
    An unexpected error occurred while processing your request. If it keeps happening,
    give your administrator the correlation ID below.
</p>
@if (ShowRequestId)
{
    <p class="ds-muted">Correlation ID: <code>@RequestId</code></p>
}
<div class="ds-form__actions">
    <a class="ds-button ds-button--primary" href="/">Back to the app</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = System.Diagnostics.Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
