@page "/settings/discovery"
@attribute [Authorize(Policy = AuthPolicies.Administer)]
@rendermode InteractiveServer
@using VSoftSol.Syslog.Core.Devices
@using VSoftSol.Syslog.Web.Devices
@inject DeviceAdminService Admin
@inject ToastService Toast

<PageTitle>Discovery — @BrandingInfo.ProductName</PageTitle>

<div class="ds-page">
    <header class="ds-page__header">
        <h1>Discovery</h1>
        <a class="ds-button ds-button--ghost" href="/settings">Settings</a>
    </header>

    @if (_loading)
    {
        <SkeletonLoader Rows="3" />
    }
    else
    {
        <form class="ds-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <FormField Label="When a message arrives from an unknown source"
                       FieldId="ds-policy"
                       Help="Auto-register is the usual choice: the device waits in the pending queue for you to name and approve it.">
                <select id="ds-policy" class="ds-input" @bind="_policy">
                    <option value="@UnknownSourcePolicy.AutoRegister">Create a pending device and queue it for approval</option>
                    <option value="@UnknownSourcePolicy.AsUnknown">Accept the message but leave it unattributed</option>
                    <option value="@UnknownSourcePolicy.Reject">Drop the message</option>
                </select>
            </FormField>

            <FormField Label="Maximum pending devices" FieldId="ds-max"
                       Help="Auto-discovery pauses when the queue reaches this size — a spoofed-source flood cannot fill the database.">
                <input id="ds-max" class="ds-input" type="number" min="1" @bind="_max" />
            </FormField>

            <div class="ds-form__actions">
                <button type="submit" class="ds-button ds-button--primary">Save</button>
            </div>
        </form>
    }
</div>

@code {
    private bool _loading = true;
    private UnknownSourcePolicy _policy = UnknownSourcePolicy.AutoRegister;
    private int _max = 500;

    protected override async Task OnInitializedAsync()
    {
        DiscoverySettings s = await Admin.GetDiscoverySettingsAsync(CancellationToken.None);
        _policy = s.UnknownSourcePolicy;
        _max = s.MaxPendingDevices;
        _loading = false;
    }

    private async Task SaveAsync()
    {
        DeviceActionResult result = await Admin.SaveDiscoverySettingsAsync(
            new DiscoverySettings { UnknownSourcePolicy = _policy, MaxPendingDevices = Math.Max(1, _max) },
            CancellationToken.None);
        Toast.Show(result.Ok ? ToastLevel.Success : ToastLevel.Error, result.Message);
    }
}
