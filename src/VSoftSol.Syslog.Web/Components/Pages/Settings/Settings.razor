@page "/settings"
@attribute [Authorize(Policy = AuthPolicies.Administer)]
@inject NavigationManager Nav
<PageTitle>Settings — @BrandingInfo.ProductName</PageTitle>
<div class="ds-page">
    <header class="ds-page__header"><h1>Settings</h1></header>
    <div class="ds-cardgrid">
        <a class="ds-card ds-card--link" href="/settings/users">
            <h2>Users &amp; access</h2>
            <p>Accounts, roles, and per-user stream / device-group scope.</p>
        </a>
        <a class="ds-card ds-card--link" href="/settings/discovery">
            <h2>Discovery</h2>
            <p>What to do with messages from an unrecognised source, and the pending-device cap.</p>
        </a>
        <a class="ds-card ds-card--link" href="/settings/listeners">
            <h2>Listeners</h2>
            <p>TLS, SNMP trap, and Windows Event Log intake — enable state, SNMP community, and API keys.</p>
        </a>
        <a class="ds-card ds-card--link" href="/settings/bundles">
            <h2>Config bundles</h2>
            <p>Export or import rules, streams, devices, users, dashboards, reports, and vendor parser packs.</p>
        </a>
        <a class="ds-card ds-card--link" href="/monitoring">
            <h2>Self-monitoring</h2>
            <p>Queue depth, drops, disk free, and archive verification status.</p>
        </a>
        <a class="ds-card ds-card--link" href="/settings/retention">
            <h2>Retention</h2>
            <p>Hot / warm / cold tiers, archive location, and the projected disk usage.</p>
        </a>
        <a class="ds-card ds-card--link" href="/settings/report-smtp">
            <h2>Report delivery</h2>
            <p>The SMTP profile scheduled reports send through.</p>
        </a>
        <a class="ds-card ds-card--link" href="/archives">
            <h2>Archives</h2>
            <p>Every exported archive, its integrity status, and restores.</p>
        </a>
        <a class="ds-card ds-card--link" href="/audit">
            <h2>Audit log</h2>
            <p>Every login, configuration change, and export.</p>
        </a>
        <a class="ds-card ds-card--link" href="/search/pattern-tester">
            <h2>Pattern tester</h2>
            <p>Build and save GROK / regex extractors against a real sample message.</p>
        </a>
        <a class="ds-card ds-card--link" href="/settings/updates">
            <h2>Updates</h2>
            <p>Check for a new release, download it once it's cryptographically verified.</p>
        </a>
    </div>
</div>
