root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

[*.{csproj,props,targets,targets,config,nuspec,xml}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------
# C# code style — enforced by `dotnet format` and EnforceCodeStyleInBuild
# ---------------------------------------------------------------------------
[*.cs]
# usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:error

# namespaces
csharp_style_namespace_declarations = file_scoped:error

# var
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# modifiers
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:error
dotnet_style_readonly_field = true:warning

# expression preferences
csharp_style_expression_bodied_methods = false:silent
csharp_prefer_braces = true:error
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# 'this.'
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_event = false:error

# naming styles
dotnet_naming_style.i_prefix_style.capitalization = pascal_case
dotnet_naming_style.i_prefix_style.required_prefix = I
dotnet_naming_style.pascal_style.capitalization = pascal_case
dotnet_naming_style.underscore_camel_style.capitalization = camel_case
dotnet_naming_style.underscore_camel_style.required_prefix = _

# interfaces start with I
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_symbols.interface_symbol.applicable_accessibilities = *

# const fields are PascalCase (checked before the instance-field rule; first match wins)
dotnet_naming_rule.const_fields_pascal.severity = warning
dotnet_naming_rule.const_fields_pascal.symbols = const_field_symbol
dotnet_naming_rule.const_fields_pascal.style = pascal_style
dotnet_naming_symbols.const_field_symbol.applicable_kinds = field
dotnet_naming_symbols.const_field_symbol.applicable_accessibilities = *
dotnet_naming_symbols.const_field_symbol.required_modifiers = const

# static fields (incl. static readonly) are PascalCase
dotnet_naming_rule.static_fields_pascal.severity = warning
dotnet_naming_rule.static_fields_pascal.symbols = static_field_symbol
dotnet_naming_rule.static_fields_pascal.style = pascal_style
dotnet_naming_symbols.static_field_symbol.applicable_kinds = field
dotnet_naming_symbols.static_field_symbol.applicable_accessibilities = *
dotnet_naming_symbols.static_field_symbol.required_modifiers = static

# remaining private instance fields are _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private, private_protected

# ---------------------------------------------------------------------------
# Security analyzer rules elevated to build errors (SECURITY_STANDARDS.md §0.5)
# ---------------------------------------------------------------------------
# Review SQL queries for security vulnerabilities.
# CA2100 flags any non-constant CommandText, including structurally-built SQL whose only
# interpolated parts are fixed identifiers and $-parameter names. The enforced guard
# against injection is SecurityCodeScan's taint-tracking SCS0002 (error, below); CA2100
# stays advisory. Every repository query binds parameters — asserted by SqlParameterizationTests.
dotnet_diagnostic.CA2100.severity = suggestion
# Do not disable certificate validation
dotnet_diagnostic.CA5359.severity = error
# Do not use deprecated / weak crypto
dotnet_diagnostic.CA5350.severity = error
dotnet_diagnostic.CA5351.severity = error
dotnet_diagnostic.CA5358.severity = error
# Do not use insecure randomness for security decisions
dotnet_diagnostic.CA5394.severity = warning
# Process command line / Process.Start review
dotnet_diagnostic.CA3006.severity = error
# Empty general catch clause (Roslynator)
dotnet_diagnostic.RCS1075.severity = error
# "Implement exception constructors" — modern guidance is to declare only the ctors used;
# the obsolete serialization ctor is intentionally omitted.
dotnet_diagnostic.RCS1194.severity = none
# SecurityCodeScan: SQL injection, path traversal, command injection, weak crypto
dotnet_diagnostic.SCS0002.severity = error
dotnet_diagnostic.SCS0001.severity = error
dotnet_diagnostic.SCS0018.severity = error
dotnet_diagnostic.SCS0026.severity = error

# ---------------------------------------------------------------------------
# Pragmatic suppressions. CLAUDE.md: "Boring code wins. Prefer readable over
# clever." These rules trade readability for micro-optimisation or ceremony that
# is not warranted in this codebase. Security rules stay elevated (above).
# ---------------------------------------------------------------------------
# LoggerMessage source-gen delegates — revisit only for proven hot paths (Phase 2+).
dotnet_diagnostic.CA1848.severity = none
# "can be marked static" — noisy on test/benchmark fixtures.
dotnet_diagnostic.CA1822.severity = suggestion
# CultureInfo overload nags on internal, non-localised strings.
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion
# "prefer static readonly array" — micro-opt.
dotnet_diagnostic.CA1861.severity = suggestion
# Validate arguments of public methods — re-enabled per phase as the API surface firms up.
dotnet_diagnostic.CA1062.severity = suggestion
# Default ConfigureAwait in non-library hosts is fine.
dotnet_diagnostic.CA2007.severity = none

# Generated code is exempt from style/analysis
[*.g.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
