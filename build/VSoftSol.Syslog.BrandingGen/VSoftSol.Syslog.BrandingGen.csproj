<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console tool for the branding pipeline (BRANDING.md). Invoked by build/branding.targets
       before Core compiles. Deliberately depends on nothing but System.Drawing.Common so it adds no
       transitive risk to the product. Not shipped. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>VSoftSol.Syslog.BrandingGen</RootNamespace>
    <AssemblyName>VSoftSol.Syslog.BrandingGen</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- This project is a build dependency of Core; it must not run the branding target itself. -->
    <_IsBrandingToolProject>true</_IsBrandingToolProject>
  </PropertyGroup>

  <!-- System.Drawing.Common (GDI+) is MIT-licensed and has no open advisories at 8.0.x. It is
       Windows-only, which matches the build host: the installer (WiX) and the product are
       Windows-only too. Replaces SixLabors.ImageSharp 2.1.13 (docs/security/SECURITY_REVIEW.md,
       "Build-tool advisory"). -->
  <ItemGroup>
    <SupportedOSPlatform Include="windows" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

</Project>
