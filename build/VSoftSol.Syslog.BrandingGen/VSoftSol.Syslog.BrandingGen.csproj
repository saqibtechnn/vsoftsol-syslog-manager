<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console tool for the branding pipeline (BRANDING.md). Invoked by build/branding.targets
       before Core compiles. Deliberately depends on nothing but ImageSharp so it adds no
       transitive risk to the product. Not shipped. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>VSoftSol.Syslog.BrandingGen</RootNamespace>
    <AssemblyName>VSoftSol.Syslog.BrandingGen</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- This project is a build dependency of Core; it must not run the branding target itself. -->
    <_IsBrandingToolProject>true</_IsBrandingToolProject>
  </PropertyGroup>

  <!-- ImageSharp 2.1.13 is the last Apache-2.0 release and has no patched 2.x (fixes are 3.x,
       Six Labors Split License - an operator licensing decision, see docs/security/SECURITY_REVIEW.md
       "Build-tool advisory"). Accepted here, and only here: this tool runs at build time on the
       operator's own branding/logo.png, takes no network input, and is never shipped. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

</Project>
